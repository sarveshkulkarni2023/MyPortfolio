generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  USER
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
}

enum ExpType {
  INTERNSHIP
  HACKATHON
  ACHIEVEMENT
  WORK
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String?
  name      String
  role      Role     @default(ADMIN)
  googleId  String?  @unique
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Project {
  id          Int            @id @default(autoincrement())
  title       String
  slug        String         @unique
  description String         @db.Text
  longDesc    String?        @db.Text
  techStack   String         @db.Text
  liveUrl     String?
  repoUrl     String?
  thumbnail   String?
  category    String
  featured    Boolean        @default(false)
  status      ProjectStatus  @default(DRAFT)
  sortOrder   Int            @default(0)
  views       Int            @default(0)
  images      ProjectImage[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status, sortOrder])
  @@map("projects")
}

model ProjectImage {
  id        Int     @id @default(autoincrement())
  url       String
  caption   String?
  sortOrder Int     @default(0)
  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_images")
}

model SkillCategory {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  icon   String?
  skills Skill[]

  @@map("skill_categories")
}

model Skill {
  id          Int           @id @default(autoincrement())
  name        String
  icon        String?
  proficiency Int           @default(50)
  categoryId  Int
  category    SkillCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("skills")
}

model Resume {
  id        Int      @id @default(autoincrement())
  title     String
  category  String
  driveUrl  String
  active    Boolean  @default(true)
  downloads Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("resumes")
}

model Certification {
  id           Int       @id @default(autoincrement())
  title        String
  issuer       String
  issueDate    DateTime
  expiryDate   DateTime?
  credentialId String?
  url          String?
  image        String?
  createdAt    DateTime  @default(now())

  @@map("certifications")
}

model Experience {
  id          Int      @id @default(autoincrement())
  title       String
  company     String
  type        ExpType
  description String   @db.Text
  startDate   DateTime
  endDate     DateTime?
  current     Boolean  @default(false)
  techStack   String?  @db.Text
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@map("experiences")
}

model Analytics {
  id        Int      @id @default(autoincrement())
  event     String
  metadata  String?  @db.Text
  ip        String?
  userAgent String?  @db.Text
  createdAt DateTime @default(now())

  @@index([event, createdAt])
  @@map("analytics")
}

model Message {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  subject   String?
  message   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("messages")
}
